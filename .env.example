# Required. Space-separated .osm.pbf URLs; pick a region from https://download.geofabrik.de/
tile_urls=https://download.geofabrik.de/europe/monaco-latest.osm.pbf

# Worker threads. Memory scales with this; raise in small steps and watch the graph.
server_threads=1

# Matrix limits. Stock Valhalla rejects anything past 20 locations.
VALHALLA_MAX_LOCATIONS=500
VALHALLA_MAX_MATRIX_PAIRS=250000
VALHALLA_COSTINGS=auto,taxi
