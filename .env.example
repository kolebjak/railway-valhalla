# Required. Space-separated .osm.pbf URLs; pick a region from
# https://download.openstreetmap.fr/extracts/ (Geofabrik is unreachable from Railway).
tile_urls=https://download.openstreetmap.fr/extracts/europe/monaco-latest.osm.pbf

# Worker threads. Memory scales with this; raise in small steps and watch the graph.
server_threads=1

# Matrix limits, applied to every matrix-capable costing.
VALHALLA_MAX_LOCATIONS=500
VALHALLA_MAX_MATRIX_PAIRS=250000
